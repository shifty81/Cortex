      "label": "Vault storage health and accounting",
      "program": "python",
      "args": [
        "tools/control/CortexPCC.py",
        "storage-health",
        "--root",
        "."
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "storage"
    },
    {
      "key": "vault.retention-plan",
      "label": "Plan Vault snapshot retention",
      "program": "python",
      "args": [
        "tools/control/CortexPCC.py",
        "vault-retention-plan",
        "--root",
        "."
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "storage"
    },
    {
      "key": "vault.gc-plan",
      "label": "Plan Vault CAS garbage collection",
      "program": "python",
      "args": [
        "tools/control/CortexPCC.py",
        "vault-gc-plan",
        "--root",
        "."
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "storage"
    }
  ],
  "quality_gates": [
    {
      "key": "fast",
      "label": "Fast development gate",
      "stages": [
        "fmt.check",
        "check"
      ]
    },
    {
      "key": "full",
      "label": "Cortex portable source build/test gate (PCC full adds Vault + GREEN certification)",
      "stages": [
        "pcc.selftest",
        "cargo.metadata",
        "fmt.check",
        "check",
        "test",
        "clippy",
        "build"
      ]
    },
    {
      "key": "forge-rust",
      "label": "Parallel Rust Forge candidate gate",
      "stages": [
        "forge.rust.fmt",
        "forge.rust.check",
        "forge.rust.test",
        "forge.rust.clippy",
        "forge.rust.build"
      ]
    }
  ],
  "artifacts": [
    {
      "key": "debug",
      "path": "artifacts/debug"
    },
    {
      "key": "diagnostics",
      "path": "artifacts/diagnostics"
    },
    {
      "key": "patches",
      "path": "artifacts/patches"
    },
    {
      "key": "handoffs",
      "path": "artifacts/handoffs"
    },
    {
      "key": "releases",
      "path": "artifacts/releases"
    },
    {
      "key": "source-refresh",
      "path": "artifacts/source-refresh"
    },
    {
      "key": "forge-rust-build",
      "path": "products/forge-rust/target"
    }
  ],
  "root_control_center": {
    "mode": "cortex-root-control-with-python-pcc-provider",
    "entrypoint": "PROJECT_CONTROL_CENTER.cmd",
    "runtime": "Cortex Root Project Control Center remains authoritative; Universal Python PCC provides typed project command/gate execution to Cortex CLI/AI/tooling",
    "upstream": "Cortex Root Control + Universal Python PCC provider",
    "external_runtime_required": false,
    "python_provider": "tools/control/ProjectControlCenter.py",
    "python_minimum_version": "3.11",
    "launcher": "PROJECT_CONTROL_CENTER.cmd",
    "machine_provider": "tools/control/ProjectControlCenter.py",
    "implementation_authority": "tools/control/CortexPCC.py",
    "forgepy_role": "external-standalone-universal-front-end",
    "project_standalone_required": true
  },
  "schema": "forge.project.v1",
  "updates": {
    "incoming": "incoming.patch",
    "patchSchema": "forge.patch.v1",
    "downloadsAutoQueue": false,
    "approvalRequiredForDownloads": true,
    "artifactAuthority": "forge",
    "lineageAuthority": "artifact-central"
  },
  "forgepy_compatibility": {
    "contract": "forge.project.v1",
    "role": "external-standalone-front-end",
    "referenceOnlyWhenAttachedToChat": true,
    "vendoredRuntimeDependency": false,
    "projectStandaloneRequired": true,
    "machineProvider": "tools/control/ProjectControlCenter.py",
    "implementationAuthority": "tools/control/CortexPCC.py"
  },
  "forge_rust_candidate": {
    "path": "products/forge-rust",
    "status": "parallel-candidate",
    "productionAuthority": "ForgePY",
    "takeoverRequiresExplicitCertification": true,
    "gui": "egui/eframe",
    "projectContract": "forge.project.v1"
  }
}
