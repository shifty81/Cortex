{
  "schema_version": 1,
  "project": {
    "id": "cortex",
    "name": "Cortex",
    "kind": "rust-workspace",
    "authority": "cortex_system"
  },
  "requirements": [
    {
      "tool": "git",
      "required": true
    },
    {
      "tool": "cargo",
      "required": true
    },
    {
      "tool": "rustc",
      "required": true
    },
    {
      "tool": "pwsh",
      "required": false
    },
    {
      "tool": "python",
      "required": true,
      "minimum_version": "3.11"
    }
  ],
  "commands": [
    {
      "key": "cargo.metadata",
      "label": "Cargo workspace metadata",
      "program": "cargo",
      "args": [
        "metadata",
        "--format-version",
        "1",
        "--no-deps"
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "tooling"
    },
    {
      "key": "pcc.selftest",
      "label": "Cortex/PCC Python regression suite",
      "program": "python",
      "args": [
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools/control/tests",
        "-p",
        "test_*.py"
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "diagnostics"
    },
    {
      "key": "fmt.check",
      "label": "Rust formatting check",
      "program": "cargo",
      "args": [
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "test"
    },
    {
      "key": "fmt.apply",
      "label": "Apply canonical Rust formatting",
      "program": "cargo",
      "args": [
        "fmt",
        "--all"
      ],
      "risk": "local_mutation",
      "side_effects": [
        "source_files"
      ],
      "permissions": [
        "workspace_write"
      ],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "tooling"
    },
    {
      "key": "check",
      "label": "Cargo workspace check",
      "program": "cargo",
      "args": [
        "check",
        "--workspace",
        "--all-targets"
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "build"
    },
    {
      "key": "test",
      "label": "Cargo workspace tests",
      "program": "cargo",
      "args": [
        "test",
        "--workspace",
        "--all-targets"
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "test"
    },
    {
      "key": "clippy",
      "label": "Clippy warnings-as-errors",
      "program": "cargo",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "test"
    },
    {
      "key": "clippy.apply",
      "label": "Apply machine-fixable Clippy repairs",
      "program": "cargo",
      "args": [
        "clippy",
        "--fix",
        "--workspace",
        "--all-targets",
        "--allow-dirty",
        "--allow-staged",
        "--allow-no-vcs",
        "--",
        "-D",
        "warnings"
      ],
      "risk": "local_mutation",
      "side_effects": [
        "source_files"
      ],
      "permissions": [
        "workspace_write"
      ],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "tooling"
    },
    {
      "key": "build",
      "label": "Build Cortex workspace",
      "program": "cargo",
      "args": [
        "build",
        "--workspace"
      ],
      "risk": "local_mutation",
      "side_effects": [
        "build_outputs"
      ],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "build"
    },
    {
      "key": "build.release",
      "label": "Build Cortex release workspace",
      "program": "cargo",
      "args": [
        "build",
        "--workspace",
        "--release"
      ],
      "risk": "local_mutation",
      "side_effects": [
        "build_outputs"
      ],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "build"
    },
    {
      "key": "forge.rust.fmt",
      "label": "Rust Forge format check",
      "category": "test",
      "risk": "read_only",
      "program": "cargo",
      "args": [
        "fmt",
        "--manifest-path",
        "products/forge-rust/Cargo.toml",
        "--all",
        "--",
        "--check"
      ],
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none"
    },
    {
      "key": "forge.rust.check",
      "label": "Rust Forge cargo check",
      "category": "build",
      "risk": "read_only",
      "program": "cargo",
      "args": [
        "check",
        "--manifest-path",
        "products/forge-rust/Cargo.toml",
        "--workspace",
        "--all-targets"
      ],
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none"
    },
    {
      "key": "forge.rust.test",
      "label": "Rust Forge tests",
      "category": "test",
      "risk": "read_only",
      "program": "cargo",
      "args": [
        "test",
        "--manifest-path",
        "products/forge-rust/Cargo.toml",
        "--workspace",
        "--all-targets"
      ],
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none"
    },
    {
      "key": "forge.rust.clippy",
      "label": "Rust Forge clippy warnings-as-errors",
      "category": "test",
      "risk": "read_only",
      "program": "cargo",
      "args": [
        "clippy",
        "--manifest-path",
        "products/forge-rust/Cargo.toml",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none"
    },
    {
      "key": "forge.rust.build",
      "label": "Build Parallel Rust Forge",
      "category": "build",
      "risk": "local_mutation",
      "program": "cargo",
      "args": [
        "build",
        "--manifest-path",
        "products/forge-rust/Cargo.toml",
        "-p",
        "forge-rs"
      ],
      "side_effects": [
        "build_outputs"
      ],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none"
    },
    {
      "key": "forge.rust.run",
      "label": "Run Parallel Rust Forge",
      "category": "run",
      "risk": "local_mutation",
      "program": "cargo",
      "args": [
        "run",
        "--manifest-path",
        "products/forge-rust/Cargo.toml",
        "-p",
        "forge-rs"
      ],
      "side_effects": [
        "build_outputs",
        "process_launch"
      ],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none"
    },
    {
      "key": "storage.status",
      "label": "Vault and shared dependency status",
      "program": "python",
      "args": [
        "tools/control/CortexPCC.py",
        "storage-status",
        "--root",
        "."
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "storage"
    },
    {
      "key": "storage.prepare",
      "label": "Prepare Vault and shared dependency paths",
      "program": "python",
      "args": [
        "tools/control/CortexPCC.py",
        "storage-prepare",
        "--root",
        "."
      ],
      "risk": "local_mutation",
      "side_effects": [
        "vault_directories"
      ],
      "permissions": [
        "vault_write"
      ],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
      "category": "storage"
    },
    {
      "key": "vault.mirror",
      "label": "Mirror current project into Vault",
      "program": "python",
      "args": [
        "tools/control/CortexPCC.py",
        "vault-mirror",
        "--root",
        "."
      ],
      "risk": "local_mutation",
      "side_effects": [
        "vault_objects",
        "vault_snapshot",
        "git_bundle_if_available"
      ],
      "permissions": [
        "vault_write"
      ],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "snapshot",
      "category": "storage"
    },
    {
      "key": "vault.verify",
      "label": "Verify latest Vault project mirror",
      "program": "python",
      "args": [
        "tools/control/CortexPCC.py",
        "vault-verify",
        "--root",
        "."
      ],
      "risk": "read_only",
      "side_effects": [],
      "permissions": [],
      "network_required": false,
      "cancellation": "bounded_kill",
      "rollback": "none",
