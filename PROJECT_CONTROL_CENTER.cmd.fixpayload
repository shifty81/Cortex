@echo off
setlocal EnableExtensions DisableDelayedExpansion
chcp 65001 >nul 2>nul

set "CORTEX_ROOT=%~dp0"
if "%CORTEX_ROOT:~-1%"=="\" set "CORTEX_ROOT=%CORTEX_ROOT:~0,-1%"

set "PCC_CORE=%CORTEX_ROOT%\tools\control\CortexPCC.py"
set "PCC_GUI=%CORTEX_ROOT%\tools\control\CortexPCCGui.py"
set "PCC_CONSOLE=%CORTEX_ROOT%\tools\control\CortexPCCConsole.py"
set "PCC_GUI_PREFLIGHT_LOG=%CORTEX_ROOT%\artifacts\logs\pcc-gui-preflight.log"
set "PCC_EXIT=1"
set "PY_EXE="
set "PY_ARGS="
set "PYW_EXE="
set "PYW_ARGS="

rem R21: restore portable/shared environment bootstrap before Python/GUI resolution.
rem The newer fail-closed GUI launcher accidentally dropped this handoff.
call :bootstrap_environment
if exist "%CORTEX_ROOT%\.cortex\bootstrap-env.cmd" call "%CORTEX_ROOT%\.cortex\bootstrap-env.cmd"

call :bootstrap_environment
rem Startup bootstrap is allowed to discover/hydrate shared Python/Git/Rust and to
rem generate .cortex\bootstrap-env.cmd.  It does NOT silently install MSVC Build
rem Tools unless the explicit IncludeBuildTools workflow is used.
if not exist "%CORTEX_ROOT%\scripts\Bootstrap-CortexEnvironment.ps1" (
  echo [WARN] Cortex environment bootstrap is missing: %CORTEX_ROOT%\scripts\Bootstrap-CortexEnvironment.ps1
  exit /b 0
)
where powershell.exe >nul 2>nul
if errorlevel 1 (
  echo [WARN] Windows PowerShell is unavailable; Cortex startup environment could not be refreshed.
  exit /b 0
)
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%CORTEX_ROOT%\scripts\Bootstrap-CortexEnvironment.ps1" -Mode Startup
if errorlevel 1 echo [WARN] Cortex environment bootstrap reported a launch blocker.
exit /b 0

:resolve_python
if errorlevel 1 goto :python_fail

rem R20 startup contract: no arguments means GUI only. CLI is explicit.
if /I "%~1"=="--cli" goto :interactive_cli
if /I "%~1"=="cli" goto :interactive_cli
if /I "%CORTEX_PCC_FORCE_CLI%"=="1" goto :interactive_cli
if not "%~1"=="" goto :headless

goto :launch_gui

:launch_gui
if not exist "%PCC_GUI%" (
  echo [FAIL] Cortex PCC GUI surface is missing: %PCC_GUI%
  set "PCC_EXIT=2"
  goto :gui_fail
)
if not exist "%CORTEX_ROOT%\artifacts\logs" mkdir "%CORTEX_ROOT%\artifacts\logs" >nul 2>nul
call :run_python "%PCC_GUI%" --self-test --root "%CORTEX_ROOT%" >"%PCC_GUI_PREFLIGHT_LOG%" 2>&1
if errorlevel 1 (
  echo [FAIL] Cortex PCC GUI preflight failed. CLI fallback is NOT automatic.
  echo [INFO] Evidence: %PCC_GUI_PREFLIGHT_LOG%
  type "%PCC_GUI_PREFLIGHT_LOG%"
  echo [INFO] Recovery CLI is explicit: PROJECT_CONTROL_CENTER.cmd --cli
  set "PCC_EXIT=3"
  goto :gui_fail
)

rem Use pythonw when available; otherwise start normal Python detached. No operation is dispatched.
if defined PYW_EXE (
  start "Cortex Project Control Center" "%PYW_EXE%" %PYW_ARGS% "%PCC_GUI%" --root "%CORTEX_ROOT%"
) else (
  start "Cortex Project Control Center" "%PY_EXE%" %PY_ARGS% "%PCC_GUI%" --root "%CORTEX_ROOT%"
)
if errorlevel 1 (
  echo [FAIL] Windows could not start the Cortex PCC GUI process.
  set "PCC_EXIT=4"
  goto :gui_fail
)
exit /b 0

:interactive_cli
if exist "%PCC_CONSOLE%" (
  call :run_python "%PCC_CONSOLE%" --root "%CORTEX_ROOT%"
) else (
  echo [WARN] Formatted PCC console surface is missing. Falling back to CortexPCC.py.
  call :run_python "%PCC_CORE%" --root "%CORTEX_ROOT%"
)
set "PCC_EXIT=%ERRORLEVEL%"
goto :done

:headless
call :run_python "%PCC_CORE%" %* --root "%CORTEX_ROOT%"
set "PCC_EXIT=%ERRORLEVEL%"
goto :done

:run_python
"%PY_EXE%" %PY_ARGS% %*
exit /b %ERRORLEVEL%

:resolve_python
rem 1. Environment selected by Cortex/shared-environment bridge.
if defined CORTEX_PYTHON_EXE if exist "%CORTEX_PYTHON_EXE%" (
  "%CORTEX_PYTHON_EXE%" -c "import sys; raise SystemExit(0 if sys.version_info >= (3,11) else 1)" >nul 2>nul
  if not errorlevel 1 (
    set "PY_EXE=%CORTEX_PYTHON_EXE%"
    for %%I in ("%CORTEX_PYTHON_EXE%") do if exist "%%~dpIpythonw.exe" set "PYW_EXE=%%~dpIpythonw.exe"
    exit /b 0
  )
)

rem 2. Portable/shared layout. First valid newest version wins. Never embed escaped quotes in variables.
for %%D in (E D C) do (
  if not defined PY_EXE if exist "%%D:\shared\toolchains\python" (
    for /f "delims=" %%P in ('dir /b /ad /o-n "%%D:\shared\toolchains\python" 2^>nul') do (
      if not defined PY_EXE if exist "%%D:\shared\toolchains\python\%%P\python.exe" (
        "%%D:\shared\toolchains\python\%%P\python.exe" -c "import sys; raise SystemExit(0 if sys.version_info >= (3,11) else 1)" >nul 2>nul
        if not errorlevel 1 (
          set "CORTEX_PYTHON_EXE=%%D:\shared\toolchains\python\%%P\python.exe"
          set "PY_EXE=%%D:\shared\toolchains\python\%%P\python.exe"
          if exist "%%D:\shared\toolchains\python\%%P\pythonw.exe" set "PYW_EXE=%%D:\shared\toolchains\python\%%P\pythonw.exe"
          set "PATH=%%D:\shared\toolchains\python\%%P;%PATH%"
        )
      )
    )
  )
)
if defined PY_EXE exit /b 0

rem 3. Windows py launcher.
where py.exe >nul 2>nul
if not errorlevel 1 (
  py.exe -3 -c "import sys; raise SystemExit(0 if sys.version_info >= (3,11) else 1)" >nul 2>nul
  if not errorlevel 1 (
    for /f "delims=" %%I in ('where py.exe') do if not defined PY_EXE set "PY_EXE=%%I"
    set "PY_ARGS=-3"
    exit /b 0
  )
)

rem 4. PATH Python.
where python.exe >nul 2>nul
if not errorlevel 1 (
  python.exe -c "import sys; raise SystemExit(0 if sys.version_info >= (3,11) else 1)" >nul 2>nul
  if not errorlevel 1 (
    for /f "delims=" %%I in ('where python.exe') do if not defined PY_EXE set "PY_EXE=%%I"
    for /f "delims=" %%I in ('where pythonw.exe 2^>nul') do if not defined PYW_EXE set "PYW_EXE=%%I"
    exit /b 0
  )
)
exit /b 1

:python_fail
echo [FAIL] Cortex Project Control Center requires Python 3.11 or newer.
echo [INFO] No GUI, CLI, FULL gate, or debug-bundle operation was started.
exit /b 1

:gui_fail
echo.
echo Cortex PCC GUI startup is RED. No project operation was started.
echo This launcher will not silently enter CLI or execute FULL.
echo.
pause
exit /b %PCC_EXIT%

:done
if not "%PCC_EXIT%"=="0" (
  echo.
  echo Cortex Project Control Center command exited with code %PCC_EXIT%.
  echo Latest evidence: %CORTEX_ROOT%\artifacts\debug\LATEST_DEBUG_BUNDLE.txt
  echo.
  pause
)
exit /b %PCC_EXIT%
