{
  "schema": "cortex.repository_layout.v1",
  "root_files": [
    ".gitattributes",
    ".gitignore",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "project.control.json",
    "PROJECT_CONTROL_CENTER.cmd",
    "README.md"
  ],
  "root_directories": [
    ".git",
    "apps",
    "config",
    "crates",
    "docs",
    "extensions",
    "products",
    "schemas",
    "scripts",
    "templates",
    "tests",
    "tools"
  ],
  "external_volume_directories": [
    "Projects",
    "Vault",
    "Models",
    "shared",
    "Intake",
    ".cortex"
  ],
  "runtime_state": {
    "data/conversations": ".cortex/conversations",
    "data/registry": ".cortex/registry",
    "logs": ".cortex/logs"
  },
  "archive_directories": {
    "migration": "Vault/history/Cortex/migration"
  },
  "archive_root_globs": [
    "APPLY_*",
    "CAPTURE_*",
    "Cortex_PCC_Emergency_*",
    "RUN_PCC_SURFACE_REPAIR_*",
    "*_HANDOFF.md",
    "HANDOFF_MANIFEST.json",
    "FILE_MANIFEST.json",
    "PACKAGE_MANIFEST.json",
    "PATCH_MANIFEST.json",
    "PORTABLE_SOURCE_MANIFEST.json",
    "SOURCE_ROLLUP_MANIFEST.json",
    "CORTEX_CUMULATIVE_UPDATE_MANIFEST.json",
    "CORTEX_R*_README*",
    "R*_README*",
    "README_PATCH.txt",
    "README_R*.txt",
    "README_R*.md",
    "README_ROOT_CONTROL_BOOTSTRAP.md",
    "Snapshot-*",
    "PROJECT_CONTROL_CENTER.cmd.fixpayload",
    "Apply-Cortex-*",
    "W*_PACKAGE_MANIFEST.json",
    "W*_GREEN_APPLY.py",
    "test_w*_green_apply.py",
    "SOURCE_*MANIFEST.json",
    "VERIFY_CORTEX_SOURCE_OVERWRITE.ps1",
    "README_OVERWRITE_FIRST.txt"
  ],
  "keep_review_root_files": [
    "BOOTSTRAP_CORTEX_ENVIRONMENT.cmd",
    "HYDRATE_CORTEX_BUILD_TOOLS.cmd",
    "SETUP_EXTERNAL_DRIVE_VAULT_ROOT.cmd",
    "RESET_VAULT_TO_DEFAULT.cmd",
    "IMPORT_CORTEX_FROM_O2DF.cmd",
    "IMPORT_CORTEX_FROM_O2DF_APPLY.cmd",
    "README_FIRST.md",
    "README.txt",
    "START_NEW_CORTEX_PROJECT_PROMPT.md",
    "stage_candidate.py",
    "test_stage_candidate.py"
  ],
  "notes": [
    "products/forge-rust remains active source until its project.control.json and command consumers are deliberately migrated.",
    "keep_review_root_files are not deleted by this pass because current source still references several of them.",
    "The six tracked logs/*/.gitkeep files are repository scaffolding, not runtime log data. Convergence migrates untracked runtime contents file-by-file and retains tracked placeholders.",
    "generated_root_directories are ignored/rebuildable local development outputs and do not violate source-authority layout.",
    "volume_runtime_state identifies legacy runtime directories that must be migrated from the repository root to the marked portable volume runtime authority."
  ],
  "preserve_runtime_placeholders": [
    "logs/arbiter_engine/.gitkeep",
    "logs/host_app/.gitkeep",
    "logs/python_bridge/.gitkeep",
    "logs/self_build/.gitkeep",
    "logs/steam_server_admin/.gitkeep",
    "logs/vs_extension/.gitkeep"
  ],
  "operational_directories": [
    ".cortex",
    ".project_control",
    "artifacts"
  ],
  "generated_root_directories": [
    "target",
    "build",
    "dist",
    "coverage",
    ".pytest_cache",
    ".venv",
    "venv",
    "env",
    "bin",
    "obj",
    ".vs",
    "TestResults",
    "node_modules",
    ".nyc_output",
    "Temp",
    "updates",
    ".local",
    "handoffs"
  ],
  "volume_runtime_state": {
    "Memory": ".cortex/data/Memory",
    "Search": ".cortex/data/Search",
    "Tasks": ".cortex/data/Tasks"
  }
}
